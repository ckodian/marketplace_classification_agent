#Environment
ENV=development

# DATABASE SETTINGS
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5533/pgvector

#OLLAMA SETTINGS
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_DEFAULT_EMBEDDER="nomic-embed-text"
OLLAMA_TEXT_MODEL="qwen2.5:7b"
OLLAMA_VISION_MODEL="qwen2.5vl:7b"
OLLAMA_EMBEDDING_DIMENSIONS=768

OLLAMA_MAX_BATCH_EMBEDDING=10

CORS_ORIGINS=["*"]
